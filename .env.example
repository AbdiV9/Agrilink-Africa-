# Owner: Person 3 (Integration, Logic & API Lead)
# Copy this file to .env and fill in what you have. Every key is optional:
# without a key the matching feature falls back to sample/offline behaviour.
# Never commit your real .env file.

# --- AI chatbot (set ONE of these; Anthropic is used if both are set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- SMS via Africa's Talking (use "sandbox" as the username while testing) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Translation (DeepL free or pro key) ---
DEEPL_KEY=

# --- AgriLink server (optional, see server/README section in README.md) ---
# URL of your deployed server, e.g. https://agrilink-server.onrender.com
SMS_SERVER_URL=
# Shared secret: set the same value on the server and in the app
SERVER_API_TOKEN=

# --- Email via SMTP (optional; Gmail needs an "app password") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- News (optional: any RSS feed URL; Google News is used if empty) ---
NEWS_FEED_URL=

# --- Optional ---
# Point the app at a different SQLite file (tests set this automatically)
AGRILINK_DB_PATH=
# Seconds between background price/harvest/season checks
NOTIFICATION_INTERVAL_SECONDS=600
# Set to 1 to print extra debug logs
AGRILINK_DEBUG=0
